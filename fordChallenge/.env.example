# SpecRadar — configuração local.
#
# Organizado por `python scripts/env_check.py --escrever`.
# Confira sem escrever com `python scripts/env_check.py`.
#
# Modelo sem valores. Copie para `.env` e preencha:
#     cp .env.example .env && python scripts/env_check.py
#

# ==========================================================================
# APLICAÇÃO
# Os interruptores. Cada um desliga uma capacidade inteira, e é assim que se
# recupera uma demonstração: desliga o interruptor, não conserta no palco.
# ==========================================================================

# login ligado. `false` na demo: a apresentação tem 8 minutos e uma tela de login gasta 20 deles sem mostrar produto
AUTH_ENABLED=false

# coleta só de cópia salva, sem sair para a rede. `1` = determinístico
REPLAY_MODE=1

# extração por fixture gravada, sem chamar provedor. `1` = custo zero de verdade, e não estimativa de zero
LLM_FAKE=1

# o Pesquisador (WP-41). Desligado, a API **não monta a rota**
RESEARCH_ENABLED=true

# o Benchmark automatizado (WP-42). Desligado, a rota não existe
BENCHMARK_ENABLED=false

# endereço em que a API escuta
API_HOST=127.0.0.1

# porta da API
API_PORT=8000

# user-agent da coleta. Identificado, com contato — é o que torna o scraping educado em vez de anônimo
#SPECRADAR_USER_AGENT=

# teto de requisições por segundo
FETCH_RATE_LIMIT_RPS=1

# onde as cópias das fontes ficam
#SNAPSHOT_DIR=

# motor de leitura de PDF
#PDF_MOTOR=


# ==========================================================================
# BANCO
# SQLite na demonstração, Postgres em produção. A demo roda em SQLite de propósito:
# um contêiner a menos é um modo de falhar a menos no dia.
# ==========================================================================

# endereço do banco (`sqlite:///…` ou `postgresql+psycopg://…`)
DATABASE_URL=sqlite:///onboarding.db

# e-mail do primeiro administrador
#ADMIN_EMAIL=

# nome do primeiro administrador
#ADMIN_NOME=

# senha do primeiro administrador
#ADMIN_PASSWORD=

# segredo de assinatura dos tokens, **mínimo 32 bytes**. Só é lido com `AUTH_ENABLED=1`, e `api/app/security.py` valida o tamanho na partida — não no primeiro login
#JWT_SECRET=


# ==========================================================================
# BUSCA
# O provedor de busca do Pesquisador. `replay` não sai para a rede e é o padrão da
# demonstração; os outros consomem cota.
# ==========================================================================

# quem responde a busca
#   aceitos: replay, tavily, exa, brave, duckduckgo, searxng
SEARCH_PROVIDER=replay

# chave do provedor de busca, quando ele exige
#SEARCH_API_KEY=

# endereço da instância SearXNG, se for o provedor
#SEARXNG_URL=

# onde as respostas de busca ficam em cache
#SEARCH_CACHE_DIR=

# Orçamento compartilhado de Tavily/Exa/Brave + Tavily Extract por pesquisa.
# Reserva antes da rede; o checkpoint preserva o limite e o consumo na retomada.
# Independente do teto de tokens do LLM. Valores são limites, não saldo gratuito.
RESEARCH_SERVICES_MAX_USD=1
RESEARCH_SERVICES_MAX_CALLS=30
# Não habilite retenção de resultados Brave sem direitos de armazenamento na conta.
SEARCH_BRAVE_STORAGE_RIGHTS=0

# Extração terceirizada opcional; vazia usa os coletores locais existentes.
#RESEARCH_EXTRACT_PROVIDER=tavily
#TAVILY_API_KEY=
#RESEARCH_EXTRACT_CACHE_DIR=
#RESEARCH_DOCUMENT_DIR=
#RESEARCH_CHECKPOINT_DIR=

# PDF: leitura digital primeiro; OCR seletivo usa somente modelos locais instalados.
# Dependências declaradas no extra pdf-ocr; falta de modelo gera estado pendente.
PDF_OCR_ENABLED=1
#PDF_OCR_MODEL_DIR=
# Docling só pode executar com artefatos locais explicitamente configurados.
#PDF_DOCLING_ARTIFACTS_PATH=


# ==========================================================================
# IA PRINCIPAL
# O provedor que o pipeline usa para extrair. Com `LLM_FAKE=1` nada aqui é chamado —
# a chave pode estar preenchida e o custo continua sendo zero de verdade.
# ==========================================================================

# quem atende
#   aceitos: anthropic, claude, deepseek, gemini, google, google-ai-studio, google_ai_studio, gpt, kimi, moonshot, moonshotai, open-ai, openai
LLM_PROVIDER=kimi

# nome do modelo, exatamente como o provedor o escreve
#LLM_MODEL=

# a chave do provedor principal
#LLM_API_KEY=

# endereço da API. **Não é luxo**: a Moonshot AI tem dois (`.cn` e `.ai`) e uma chave de um não vale no outro
#LLM_API_BASE=

# segundos entre duas chamadas (cota do plano)
#LLM_MIN_INTERVAL_S=


# ==========================================================================
# IA ALTERNATIVA
# O segundo provedor, para quando o primeiro está sem saldo, fora do ar ou lento
# demais para o orçamento. Mesmos nomes com sufixo `_ALT`.
#
# **`LLM_MODEL_ALT` é nome de modelo, não chave.** Ela já guardou uma credencial
# nesta máquina, e como nenhum código a lia, nada quebrou — um segredo na variável
# errada não dá erro, só fica. `scripts/env_check.py` passou a conferir o formato.
# ==========================================================================

# quem atende quando o principal não atende
#   aceitos: (vazio), anthropic, claude, deepseek, gemini, google, google-ai-studio, google_ai_studio, gpt, kimi, moonshot, moonshotai, open-ai, openai
#LLM_PROVIDER_ALT=

# nome do modelo alternativo
#LLM_MODEL_ALT=

# a chave do provedor alternativo
#LLM_API_KEY_ALT=

# endereço da API alternativa
#LLM_API_BASE_ALT=
